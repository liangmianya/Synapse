{
  "name": "synapse-learning-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Synapse - non-linear AI learning workspace",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"node server.js\" \"vite --host 127.0.0.1 --port 4173 --strictPort\"",
    "build": "vite build",
    "start": "node server.js",
    "check": "node --check server.js && node --check app.js && vite build"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "marked": "^18.0.9",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "vite": "^8.2.1"
  },
  "engines": {
    "node": ">=18"
  }
}
